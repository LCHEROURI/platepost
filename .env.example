# Copy to .env.local and fill in from the Firebase console (Project settings > Your apps).
# Without these values the app runs in local demo mode (data persisted in localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Run AI caption service (see functions/ai). No secrets here — the service
# authenticates callers with Firebase ID tokens and calls Gemini server-side.
VITE_AI_SERVICE_URL=

# Cloud Run Meta publishing service (see functions/meta). No secrets here —
# Meta App credentials live in Secret Manager and tokens in Firestore, server-side only.
VITE_META_SERVICE_URL=
